<script>
const products=[
{id:1,name:'Laundry Baskets',cat:'Laundry',desc:'Laundry and storage baskets in different styles and sizes.',price:'Ask for current price',img:'https://images.unsplash.com/photo-1582735689369-4fe89db7114c?auto=format&fit=crop&w=700&q=80'},
{id:2,name:'Bakery Pans',cat:'Bakery',desc:'Bakeware options for cakes, bread and pastries.',price:'Ask for current price',img:'https://d163axztg8am2h.cloudfront.net/static/img/74/0d/ae40a8b3415a4369ace61069a295.webp'},
{id:3,name:'Commercial Bakeware',cat:'Bakery',desc:'Larger bakery pan options for business use.',price:'Ask for current price',img:'https://i5.walmartimages.com/asr/61542d03-c2fa-4de6-a40b-90b7ba7e465c_1.07705970fae5c133679fd6350d01343d.jpeg'},
{id:4,name:'Bakery Equipment',cat:'Equipment',desc:'Equipment and tools for food preparation.',price:'Ask for current price',img:'https://images.unsplash.com/photo-1556911220-e15b29be8c8f?auto=format&fit=crop&w=700&q=80'}
];
let category='All',cart=[];
function renderProducts(){const q=document.getElementById('search').value.toLowerCase();const list=products.filter(p=>(category==='All'||p.cat===category)&&(!q||(`${p.name} ${p.cat} ${p.desc}`).toLowerCase().includes(q)));document.getElementById('productList').innerHTML=list.length?list.map(p=>`<article class="product"><div class="pic"><img src="${p.img}" alt="${p.name}"></div><div class="info"><h3>${p.name}</h3><p>${p.desc}</p><div class="price">${p.price}</div><div class="product-actions"><button class="add" onclick="addToCart(${p.id})">Add to Order</button><button class="ask" onclick="askAbout('${p.name.replace(/'/g,"\\'")}')">Ask AI</button></div></div></article>`).join(''):'<div class="empty">No matching products found.</div>'}
function setCategory(c,el){category=c;document.querySelectorAll('.chip').forEach(x=>x.classList.remove('active'));el.classList.add('active');renderProducts()}
function addToCart(id){const p=products.find(x=>x.id===id);const item=cart.find(x=>x.id===id);if(item)item.qty++;else cart.push({...p,qty:1});updateCart();toast(p.name+' added to order')}
function updateCart(){document.getElementById('cartCount').textContent=cart.reduce((s,x)=>s+x.qty,0);const box=document.getElementById('cartItems');if(!cart.length){box.innerHTML='<div class="empty">Your order is empty. Add products from the shop.</div>';document.getElementById('cartTotal').textContent='';return}box.innerHTML=cart.map(x=>`<div class="cart-row"><div class="grow"><b>${x.name}</b><br><small>${x.price}</small></div><div class="qty"><button onclick="changeQty(${x.id},-1)">−</button> <b>${x.qty}</b> <button onclick="changeQty(${x.id},1)">+</button></div></div>`).join('');document.getElementById('cartTotal').textContent='Items: '+cart.reduce((s,x)=>s+x.qty,0)}
function changeQty(id,d){const x=cart.find(i=>i.id===id);if(!x)return;x.qty+=d;if(x.qty<=0)cart=cart.filter(i=>i.id!==id);updateCart()}
function openCart(){updateCart();document.getElementById('cartModal').classList.add('show')}function closeCart(){document.getElementById('cartModal').classList.remove('show')}
function sendOrder(){if(!cart.length){toast('Add a product first');return}const name=document.getElementById('customerName').value.trim()||'Customer';const loc=document.getElementById('customerLocation').value.trim()||'Not provided';const note=document.getElementById('customerNote').value.trim();const items=cart.map(x=>`${x.name} x${x.qty}`).join(', ');const text=`Hello FRENZY ENTERPRISE!%0A%0AI want to place an order.%0AName: ${encodeURIComponent(name)}%0ALocation: ${encodeURIComponent(loc)}%0AProducts: ${encodeURIComponent(items)}%0ANote: ${encodeURIComponent(note||'None')}`;window.open('https://wa.me/233597131121?text='+text,'_blank')}
function shareApp(){const data={title:'FRENZY ENTERPRISE',text:'Check out FRENZY ENTERPRISE!',url:location.href};if(navigator.share)navigator.share(data).catch(()=>{});else{navigator.clipboard?.writeText(location.href);toast('App link copied')}}
function scrollToId(id){document.getElementById(id)?.scrollIntoView({behavior:'smooth'})}
function askAbout(name){document.getElementById('chatInput').value='Tell me about '+name;scrollToId('ai');setTimeout(sendMessage,350)}
function quickAsk(q){document.getElementById('chatInput').value=q;sendMessage()}
function addMessage(t,type){const box=document.getElementById('messages');const m=document.createElement('div');m.className='msg '+type;m.textContent=t;box.appendChild(m);box.scrollTop=box.scrollHeight}
function getAIReply(q){const s=q.toLowerCase().trim();if(/^(hi|hello|hey|good morning|good afternoon|good evening)\b/.test(s))return'Hello! 👋 Welcome to FRENZY ENTERPRISE. How can I help?';if(s.includes('who are you'))return"I'm FRENZY AI, the customer assistant for FRENZY ENTERPRISE.";if(s.includes('product')||s.includes('sell')||s.includes('available'))return'We currently feature laundry baskets, bakery pans, commercial bakeware and bakery equipment. You can add products to an order from the Shop section.';if(s.includes('basket')||s.includes('laundry'))return'Our laundry baskets are suitable for laundry and storage. Ask us for the size, style and current price available.';if(s.includes('pan')||s.includes('bakeware')||s.includes('cake'))return'We feature bakery pans and bakeware for cakes, bread and pastries. Tell us the type or size you need.';if(s.includes('equipment')||s.includes('machine'))return'We feature bakery equipment and food-preparation tools. Tell us what you are looking for and the team can confirm availability.';if(s.includes('price')||s.includes('cost')||s.includes('how much'))return'Current prices are not stored in this app. Please contact 0597131121 or 0597131121 on WhatsApp for the latest price.';if(s.includes('delivery')||s.includes('deliver')||s.includes('shipping'))return'Delivery depends on your location and the item. Contact 0597131121 with your location and product details.';if(s.includes('order')||s.includes('buy')||s.includes('purchase'))return'You can add products to your Order, enter your name and location, then send the order through WhatsApp.';if(s.includes('location')||s.includes('where')||s.includes('map'))return'The app currently points to Koforidua, Ghana. Open the Map section for directions. Contact us for the exact business location.';if(s.includes('phone')||s.includes('number')||s.includes('call')||s.includes('whatsapp'))return'You can reach FRENZY ENTERPRISE on 0597131121.';if(s.includes('email')||s.includes('mail'))return'Our email is frenzycheetah18@gmail.com.';if(s.includes('hours')||s.includes('open')||s.includes('close'))return'Opening hours are not stored in the app yet. Please contact 0597131121 for current hours.';if(s.includes('help'))return'I can help with products, ordering, delivery, prices, location and contact details. For questions outside the information stored here, our team can help directly.';return'I do not have enough FRENZY-specific information to answer that accurately. Try asking about products, prices, ordering, delivery, location or contact details, or message our team on WhatsApp.'}
function sendMessage(){const input=document.getElementById('chatInput');const q=input.value.trim();if(!q)return;addMessage(q,'user');input.value='';setTimeout(()=>addMessage(getAIReply(q),'bot'),250)}
function toast(t){const x=document.getElementById('toast');x.textContent=t;x.classList.add('show');setTimeout(()=>x.classList.remove('show'),2200)}
renderProducts();updateCart();
</script>

<div id="installBanner" style="display:none;position:fixed;left:12px;right:12px;bottom:78px;z-index:90;background:#111;color:#fff;border-radius:16px;padding:13px;box-shadow:0 10px 30px #0005;">
  <div style="display:flex;align-items:center;gap:10px">
    <div style="flex:1"><b>Install FRENZY</b><br><small style="color:#ccc">Add FRENZY ENTERPRISE to your phone like an app.</small></div>
    <button id="installBtn" style="border:0;border-radius:10px;padding:10px 13px;font-weight:800">Install</button>
    <button id="dismissInstall" style="border:0;background:#333;color:#fff;border-radius:10px;padding:10px">✕</button>
  </div>
</div>

<script>
let deferredInstallPrompt;
window.addEventListener('beforeinstallprompt', (e) => {
  e.preventDefault();
  deferredInstallPrompt = e;
  const banner = document.getElementById('installBanner');
  if (banner && !localStorage.getItem('frenzy-install-dismissed')) banner.style.display='block';
});
document.getElementById('installBtn')?.addEventListener('click', async () => {
  if (!deferredInstallPrompt) return;
  deferredInstallPrompt.prompt();
  await deferredInstallPrompt.userChoice;
  deferredInstallPrompt = null;
  document.getElementById('installBanner').style.display='none';
});
document.getElementById('dismissInstall')?.addEventListener('click', () => {
  document.getElementById('installBanner').style.display='none';
  localStorage.setItem('frenzy-install-dismissed','1');
});
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => navigator.serviceWorker.register('./sw.js').catch(console.error));
}
</script>
